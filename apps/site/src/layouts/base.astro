---
import ThemeToggle from '@site/theme-toggle';
import { buttonVariants } from '@site/ui/components/button';
import { Separator } from '@site/ui/components/separator';
import { OG_DEFAULT, OG_SIZE, SITE } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** OG 카드 경로. 없으면 사이트 공용 카드 */
  image?: string;
  /** 있으면 글 페이지로 취급 — og:type=article + BlogPosting JSON-LD */
  article?: { publishedAt: Date };
}

const {
  title = SITE.name,
  description = SITE.description,
  image = OG_DEFAULT,
  article,
} = Astro.props;

const path = Astro.url.pathname;

// 빌드에서는 astro.config.mjs의 site가 쓰인다. Astro.site가 없는 환경
// (Container API 등)에서도 죽지 않도록 요청 URL로 되돌린다.
const origin = Astro.site ?? Astro.url;
const canonical = new URL(path, origin);

// og:image는 상대경로를 못 읽는 크롤러가 많다 — canonical과 같은 방식으로 절대화한다
const ogImage = new URL(image, origin);

// 제목 끝의 사이트 이름은 <title> 표기용 꼬리표다. 구조화 데이터에는 글 제목만 넣는다
const suffix = ` — ${SITE.name}`;
const headline = title.endsWith(suffix)
  ? title.slice(0, -suffix.length)
  : title;

const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline,
  description,
  datePublished: article.publishedAt.toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  url: canonical.href,
  image: ogImage.href,
  inLanguage: 'ko-KR',
};

const nav = [
  { href: '/retrospect/', label: '회고' },
  { href: '/resume/', label: '이력서' },
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} 회고`}
      href="/rss.xml"
    />
    <title>{title}</title>

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <!-- 첫 페인트 전에 테마를 결정해 깜빡임(FOUC)을 막는다 -->
    <script is:inline>
      const stored = localStorage.getItem('theme');
      document.documentElement.dataset.theme =
        stored ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  </head>
  <body class="flex min-h-svh flex-col antialiased">
    <header
      class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/60"
    >
      <div
        class="mx-auto flex h-14 w-full max-w-3xl items-center justify-between gap-4 px-4 sm:px-6"
      >
        <a
          href="/"
          class="rounded-md font-semibold tracking-tight outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
          aria-current={path === '/' ? 'page' : undefined}
        >
          sbjang
        </a>
        <div class="flex items-center gap-1">
          <nav class="flex items-center gap-1" aria-label="주요">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    buttonVariants({ variant: 'ghost', size: 'sm' }),
                    isCurrent(item.href)
                      ? 'bg-accent text-accent-foreground'
                      : 'text-muted-foreground',
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <Separator
            orientation="vertical"
            className="mx-1 data-[orientation=vertical]:h-5"
          />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6 sm:py-14">
      <slot />
    </main>

    <footer class="border-t border-border/60">
      <div
        class="mx-auto flex w-full max-w-3xl flex-col gap-1 px-4 py-8 text-sm text-muted-foreground sm:px-6"
      >
        <p>© {year} sbjang</p>
        <p>Astro 아일랜드 · React · Svelte · shadcn/ui</p>
      </div>
    </footer>
  </body>
</html>
