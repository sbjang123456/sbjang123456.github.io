---
import { getCollection } from 'astro:content';
import { PostSearch } from '@site/post-search';
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@site/ui/components/card';
import Base from '../../layouts/base.astro';

const posts = (await getCollection('retrospect')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// 아일랜드로 넘기는 props는 직렬화 가능해야 한다 (Date 객체 대신 문자열)
const summaries = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  date: post.data.date.toISOString().slice(0, 10),
  url: `/retrospect/${post.id}/`,
}));
---

<Base title="회고 — sbjang" description="sbjang이 쓴 개발 회고 모음.">
  <header class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">회고</h1>
    <p class="text-muted-foreground">글 {posts.length}개</p>
  </header>

  <div class="mt-8">
    <PostSearch client:load posts={summaries} />
  </div>

  <ul class="mt-8 flex flex-col gap-3">
    {
      posts.map((post) => (
        <li>
          <a
            href={`/retrospect/${post.id}/`}
            class="group block rounded-xl outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
          >
            <Card className="transition-colors group-hover:border-foreground/20 group-hover:bg-accent/40">
              <CardHeader>
                <CardTitle className="underline-offset-4 group-hover:underline">
                  {post.data.title}
                </CardTitle>
                <CardDescription>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toISOString().slice(0, 10)}
                  </time>
                </CardDescription>
              </CardHeader>
            </Card>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
