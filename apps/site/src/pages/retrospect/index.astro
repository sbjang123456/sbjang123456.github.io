---
import { getCollection } from 'astro:content';
import PostList from '@site/retrospect';
import { RETROSPECT } from '@site/retrospect/meta';
import Base from '../../layouts/base.astro';

const posts = (await getCollection('retrospect')).map((post) => ({
  id: post.id,
  ...post.data,
}));
---

<Base
  title={`${RETROSPECT.title} — sbjang`}
  description={RETROSPECT.description}
  image={RETROSPECT.ogImage}
>
  <PostList posts={posts} />
</Base>
