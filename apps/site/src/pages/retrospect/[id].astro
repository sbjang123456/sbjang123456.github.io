---
import { getCollection, render } from 'astro:content';
import PostArticle from '@site/retrospect/post';
import Base from '../../layouts/base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('retrospect');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} — sbjang`}
  description={post.data.description}
  image={`/og/${post.id}.png`}
  article={{ publishedAt: post.data.date }}
>
  <PostArticle post={{ id: post.id, ...post.data }}>
    <Content />
  </PostArticle>
</Base>
