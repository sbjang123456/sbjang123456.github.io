---
import { findProject, projectSlugs } from '../projects/index';
import ProjectDisclosure from './project-disclosure.astro';
import ProjectNameList from './project-name-list.astro';

interface Props {
  projects: string[];
  /** 참이면 프로젝트마다 펼칠 수 있는 상세를 단다. */
  expandable?: boolean;
}

const { projects, expandable = false } = Astro.props;

// 랜딩과 전체보기가 갈리는 유일한 자리. 나머지 컴포넌트는 둘 다에서 같다.
const anchor = (project: string) => `/resume/all/#${projectSlugs[project]}`;
---

<div data-slot="projects" class="mt-1 flex flex-col gap-1 border-l-2 border-border pl-3">
  <h4 class="text-xs font-medium">프로젝트</h4>
  {
    expandable ? (
      <div class="flex flex-col gap-1">
        {projects.map((project) => (
          <ProjectDisclosure project={findProject(project)} />
        ))}
      </div>
    ) : (
      <ProjectNameList projects={projects} href={anchor} />
    )
  }
</div>
