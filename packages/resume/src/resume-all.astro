---
import { buttonVariants } from '@site/ui/components/button';
import { resume as defaultResume, type Resume } from './data';
import './print.css';
import { projects } from './projects/index';
import CareerBrief from './sections/career-brief.astro';
import Contacts from './sections/contacts.astro';

interface Props {
  /** 기본값은 이 패키지의 data.ts. 테스트나 미리보기에서 갈아끼울 수 있다. */
  resume?: Resume;
}

const { resume = defaultResume } = Astro.props;

/*
 * PDF는 빌드 산출물이다 — `scripts/build-resume-pdf.ts`가 dist를 인쇄해 만든다.
 * dev 서버에는 그 파일이 없으므로 개발 중에는 죽은 링크 대신 버튼을 감춘다.
 */
const hasPdf = import.meta.env.PROD;
---

<a
  href="/resume/"
  data-print-hidden
  class={buttonVariants({ variant: 'ghost', size: 'sm', className: '-ml-3' })}
>
  ← 이력서
</a>

<header class="mt-6 flex flex-col gap-2">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
      이력서 전체보기
    </h1>
    {
      hasPdf && (
        <a
          href="/resume.pdf"
          download={`${resume.name}-이력서.pdf`}
          data-resume-pdf
          data-print-hidden
          class={buttonVariants({ variant: 'outline', size: 'sm' })}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="m7 10 5 5 5-5" />
            <path d="M12 15V3" />
          </svg>
          PDF 내려받기
        </a>
      )
    }
  </div>
  <p class="text-muted-foreground">
    회사 {resume.careers.length}곳 · 프로젝트 {projects.length}개. 회사를
    누르면 그 회사에서 한 일이 펼쳐집니다.
  </p>
  <Contacts contacts={resume.contacts} />
</header>

<div class="mt-8">
  <CareerBrief careers={resume.careers} />
</div>

{/*
  저장되는 파일명에는 내려받는 날짜를 붙인다 (`이름-이력서_YYYY-MM-DD.pdf`).
  정적 사이트라 빌드 때는 그 날을 알 수 없어 브라우저가 붙인다 — 번들도
  아일랜드도 아닌 인라인 몇 줄이다. 스크립트가 돌지 않으면 download 속성
  값 그대로 날짜 없이 저장되고, dev 서버에는 버튼이 없어 아무 일도 안 한다.
  toISOString은 UTC라 아침에 받으면 어제가 된다 — 로컬 날짜로 만든다.
*/}
<script is:inline>
  {
    const link = document.querySelector('a[data-resume-pdf]');
    if (link instanceof HTMLAnchorElement) {
      const now = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      link.download = link.download.replace(/\.pdf$/, `_${today}.pdf`);
    }
  }
</script>
