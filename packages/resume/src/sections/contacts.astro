---
import type { Resume } from '../data';

interface Props {
  contacts: Resume['contacts'];
}

const { contacts } = Astro.props;
---

{/*
  이력서 랜딩과 전체보기가 같은 줄을 쓴다 — 주소는 data.ts 한 곳에만 적는다.
  인쇄에서 숨기지 않는다: PDF를 받아 든 사람에게는 이 줄이 유일한 연락처다.
*/}
<ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
  {
    contacts.map((contact) => (
      <li>
        <a
          href={contact.href}
          class="rounded-sm text-muted-foreground underline underline-offset-4 outline-none hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50"
        >
          {contact.label}
        </a>
      </li>
    ))
  }
</ul>
