---
import { buttonVariants } from '@site/ui/components/button';
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@site/ui/components/card';
import CareerProjects from '../career/career-projects.astro';
import { type Career, formatPeriod } from '../data';

interface Props {
  careers: Career[];
}

const { careers } = Astro.props;
---

<Card>
  <CardHeader>
    <CardTitle>경력</CardTitle>
    <CardDescription>조직과 기간, 맡은 일</CardDescription>
  </CardHeader>
  <CardContent>
    {
      careers.length === 0 ? (
        <p class="text-sm text-muted-foreground">(작성 예정)</p>
      ) : (
        <ol class="flex flex-col gap-8">
          {careers.map((career) => (
            <li class="flex flex-col gap-2">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 data-slot="career-org" class="font-medium">
                  {career.org}
                  <span class="text-muted-foreground"> · {career.role}</span>
                </h3>
                <span class="text-sm text-muted-foreground tabular-nums">
                  {formatPeriod(career)}
                </span>
              </div>
              {career.highlights.length > 0 && (
                <ul class="flex list-disc flex-col gap-1 pl-5 text-sm text-muted-foreground">
                  {career.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
              {career.projects.length > 0 && (
                /* 재직 중인 회사만 펼쳐 본다 — 회사 이름을 코드에 박지 않으려고
                   `to`가 없다는 사실에서 유도한다. 이직해도 저절로 맞는다. */
                <CareerProjects
                  projects={career.projects}
                  expandable={!career.to}
                />
              )}
            </li>
          ))}
        </ol>
      )
    }
  </CardContent>
  <CardFooter>
    <a
      href="/resume/all/"
      class={buttonVariants({ variant: 'outline', size: 'sm' })}
    >
      이력서 전체보기 →
    </a>
  </CardFooter>
</Card>
