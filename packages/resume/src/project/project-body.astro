---
import type { Project } from '../projects/types';
import ProjectSection from './project-section.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// 요약은 접힌 <summary>가 이미 보여 준다 — 여기서 되풀이하지 않는다.
const { note, sections, links } = project;
---

<div class="flex flex-col gap-4 text-sm">
  {
    note && (
      <blockquote class="border-l-2 border-border pl-3 whitespace-pre-line text-muted-foreground">
        {note}
      </blockquote>
    )
  }

  {sections.map((section) => <ProjectSection section={section} />)}

  {
    links && links.length > 0 && (
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-sm break-all text-muted-foreground underline underline-offset-4 outline-none hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50"
              rel="noopener noreferrer"
              target="_blank"
            >
              {link.label} ↗
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>
