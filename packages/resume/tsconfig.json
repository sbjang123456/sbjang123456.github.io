{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    /* import.meta.glob과 *.webp 모듈 타입은 astro/client가 들고 있다 */
    "types": ["astro/client"]
  },
  "include": ["src"]
}
