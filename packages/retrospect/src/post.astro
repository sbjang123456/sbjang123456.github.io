---
import { buttonVariants } from '@site/ui/components/button';
import { Separator } from '@site/ui/components/separator';
import type { Post } from './meta';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const date = post.date.toISOString();
---

<a
  href="/retrospect/"
  class={buttonVariants({ variant: 'ghost', size: 'sm', className: '-ml-3' })}
>
  ← 목록으로
</a>

<article class="mt-6">
  <header class="flex flex-col gap-3">
    <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
      {post.title}
    </h1>
    <time datetime={date} class="text-sm text-muted-foreground">
      {date.slice(0, 10)}
    </time>
  </header>

  <Separator className="my-8" />

  <div class="prose prose-zinc max-w-none dark:prose-invert">
    <slot />
  </div>
</article>
